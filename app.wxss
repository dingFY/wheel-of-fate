page {
  box-sizing: border-box;
  min-height: 100vh;
  background: #f7f3ec;
  color: #232323;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
image,
button,
input {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.section-title {
  margin: 36rpx 0 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.recipe-card {
  display: flex;
  gap: 22rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 42, 25, 0.06);
}

.recipe-cover {
  width: 176rpx;
  height: 136rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f6c177, #ef6b3a);
  flex-shrink: 0;
}

.recipe-info {
  flex: 1;
  min-width: 0;
}

.recipe-name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.recipe-desc {
  margin-top: 10rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 1.5;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 6rpx 12rpx;
  color: #9a4b2e;
  background: #fff0e8;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.empty {
  padding: 90rpx 0;
  color: #999;
  text-align: center;
  font-size: 28rpx;
}
