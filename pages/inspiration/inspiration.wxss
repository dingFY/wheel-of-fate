.story-page{min-height:100vh;background:linear-gradient(180deg,#f2efff 0,#faf6f1 430rpx);padding:38rpx 28rpx 70rpx;box-sizing:border-box}.story-header{text-align:center;padding:12rpx 0 34rpx}.story-badge{font-size:70rpx}.story-title{font-size:42rpx;font-weight:800;color:#3f345b;margin-top:12rpx}.story-subtitle{font-size:24rpx;color:#8e84a4;margin-top:10rpx}.selector-card{background:rgba(255,255,255,.92);border:1rpx solid rgba(113,91,224,.1);border-radius:26rpx;padding:26rpx 24rpx;margin-bottom:20rpx;box-shadow:0 10rpx 28rpx rgba(92,74,154,.06)}.step-title{font-size:28rpx;font-weight:700;color:#493f5c}.step-title text{color:#7764df;margin-right:12rpx}.option-row{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:20rpx}.choice{padding:14rpx 24rpx;border-radius:30rpx;background:#f5f1ed;color:#897b72;font-size:25rpx;border:2rpx solid transparent}.choice-active{background:#7764df;color:#fff;box-shadow:0 7rpx 16rpx rgba(119,100,223,.24)}.advanced-toggle{display:flex;justify-content:space-between;align-items:center;background:rgba(255,255,255,.72);border:1rpx dashed #b7a9dc;border-radius:22rpx;padding:22rpx 24rpx;color:#6f5ec6;font-size:25rpx}.advanced-card{background:#fff;border-radius:24rpx;padding:8rpx 24rpx 22rpx;margin-top:14rpx;box-shadow:0 10rpx 28rpx rgba(92,74,154,.06)}.advanced-group{padding-top:20rpx}.advanced-label{font-size:24rpx;font-weight:700;color:#62566a}.compact{margin-top:12rpx}.choice.small{padding:10rpx 18rpx;font-size:22rpx}.generate-button{margin:30rpx 0;background:linear-gradient(135deg,#7764df,#e76589);color:#fff;border-radius:50rpx;font-size:30rpx;font-weight:700;line-height:92rpx;box-shadow:0 14rpx 30rpx rgba(119,100,223,.23)}.generate-button::after,.accept-button::after,.poster-button::after{border:0}.result-card{background:#fff;border-radius:30rpx;padding:30rpx 26rpx;box-shadow:0 16rpx 40rpx rgba(89,65,91,.1);border-top:8rpx solid #7764df}.result-label{font-size:21rpx;color:#9c8eaa}.result-title{font-size:38rpx;font-weight:800;color:#40344d;margin:10rpx 0 26rpx}.script-intro{background:linear-gradient(135deg,#f0edff,#fff1f5);border-radius:20rpx;padding:20rpx 22rpx;margin-bottom:12rpx}.script-intro view{font-size:25rpx;color:#51475c;line-height:1.6}.script-intro text{display:inline-block;min-width:120rpx;font-size:20rpx;color:#8f80a8;margin-right:12rpx}.story-line{display:flex;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #f0e9e7}.line-icon{width:68rpx;height:68rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;margin-right:20rpx;flex:none}.purple{background:#eeeaff}.orange{background:#fff0df}.blue{background:#e6f3ff}.red{background:#ffe8e8}.line-label{font-size:21rpx;color:#a09199}.line-value{font-size:27rpx;color:#493e46;font-weight:600;margin-top:5rpx}.script-meta{display:flex;flex-direction:column;gap:8rpx;background:#f6f2ee;border-radius:18rpx;padding:18rpx 20rpx;margin-top:22rpx;color:#887781;font-size:22rpx}.narrative{background:#faf6f2;color:#806e76;font-size:25rpx;line-height:1.75;padding:22rpx;border-radius:18rpx;margin-top:24rpx}.narrative view{font-weight:700;color:#6f5ec6;margin-bottom:8rpx}.result-actions{display:flex;gap:14rpx;margin-top:24rpx;align-items:center}.accept-button,.poster-button{flex:1;border-radius:40rpx;font-size:26rpx;line-height:60rpx;white-space:nowrap;overflow:hidden}.accept-button{background:#7764df;color:#fff}.poster-button{background:#fff0f3;color:#d9587a}.history-section{margin-top:40rpx}.history-title{font-size:30rpx;font-weight:700;color:#4b3d4b;margin-bottom:16rpx}.history-card{background:#fff;border-radius:20rpx;padding:20rpx 22rpx;margin-bottom:14rpx}.history-main{display:flex;justify-content:space-between;align-items:center}.history-main text:first-child{font-size:26rpx;font-weight:700;color:#514552}.history-main text:last-child{font-size:19rpx;color:#8b75d2}.history-desc{font-size:22rpx;color:#998a91;margin-top:9rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.poster-canvas{position:fixed;left:-9999px;top:0;width:750px;height:1550px}
.quick-zone{display:flex;flex-direction:column;align-items:center;gap:20rpx;margin-bottom:28rpx}
.quick-button{width:100%;background:linear-gradient(135deg,#7764df,#e76589);color:#fff;border-radius:50rpx;font-size:34rpx;font-weight:700;line-height:100rpx;display:flex;align-items:center;justify-content:center;gap:12rpx;box-shadow:0 14rpx 30rpx rgba(119,100,223,.28)}
.quick-button::after{border:0}
.quick-icon{font-size:38rpx}
.quick-text{font-size:34rpx;font-weight:700}
.custom-toggle{color:#7764df;font-size:25rpx;padding:10rpx 28rpx;border-radius:30rpx;background:rgba(119,100,223,.08);border:1rpx dashed #b7a9dc}
.custom-zone{margin-bottom:20rpx}
.reroll-button{flex:1;border-radius:40rpx;font-size:26rpx;line-height:60rpx;background:#f2efff;color:#7764df;white-space:nowrap;overflow:hidden}
.reroll-button::after{border:0}
.history-more{text-align:center;font-size:24rpx;color:#8b75d2;padding:18rpx 0;background:rgba(119,100,223,.06);border-radius:16rpx;margin-top:10rpx}
.time-group{margin-top:16rpx}.time-group-label{font-size:22rpx;color:#998aaa;margin-bottom:8rpx}.itinerary{background:#f8f4ff;border-radius:20rpx;padding:20rpx;margin-top:20rpx}.itinerary-title{font-weight:700;color:#6f5ec6;font-size:25rpx;margin-bottom:10rpx}.itinerary-item{padding:12rpx 0;border-bottom:1rpx solid #e9e1f4;color:#6d626c;font-size:22rpx;line-height:1.5}.itinerary-item:last-child{border-bottom:0}.itinerary-item text{display:block;color:#514475;font-weight:700;margin-bottom:4rpx}
